# === uwu-ai-agent service configuration ===
# AI-агент (консультант покупателей) — отдельный сервис, клиент REST API ядра UWU.

# Окружение: development | production
ENVIRONMENT=production

# Порт control-plane агента (healthz, webhook, отладка)
AGENT_PORT=8100
LOG_LEVEL=INFO

# --- Ядро UWU (REST API, к которому обращается агент) ---
# Базовый URL ядра. Внутри docker-compose — имя сервиса ядра; локально — localhost.
UWU_API_BASE_URL=http://localhost:8000
# API-ключ агента (создаётся в админке UWU: /admin/agent/keys). Показывается один раз.
UWU_API_KEY=
# Таймаут HTTP-запросов к ядру, секунды.
UWU_API_TIMEOUT_SECONDS=30.0

# --- LLM (OpenAI-совместимый API; провайдер задаётся конфигом, не кодом) ---
# По умолчанию настроен DeepSeek API (https://api-docs.deepseek.com):
# ключ создаётся в ЛК DeepSeek (platform.deepseek.com -> API keys).
# Модели: deepseek-chat (DeepSeek-V3, tool-calling) и deepseek-reasoner (R1).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Checkpointer LangGraph (persistence между сообщениями и interrupt/resume) ---
# PostgreSQL-строку подключения; пусто = in-memory checkpointer (только разработка).
# Схема хранения состояний графа.
CHECKPOINT_DB_URL=
CHECKPOINT_SCHEMA=agent
